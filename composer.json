{
  "name": "luxid/framework",
  "description": "Starter project for Luxid Framework",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "framework",
    "starter",
    "luxid",
    "php"
  ],
  "require": {
    "php": "^8.1",
    "luxid/engine": "^0.8",
    "luxid/nova": "^0.2",
    "luxid/rocket": "^0.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Luxid\\Framework\\": "config/"
    }
  },
  "authors": [
    {
      "name": "Jhay",
      "email": "jhay@luxid.dev"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-create-project-cmd": [
      "php -r \"if (file_exists('.env.example') && !file_exists('.env')) copy('.env.example', '.env');\"",
      "Luxid\\Framework\\Kernel::postCreateProject"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Engine",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Nova",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Rocket-ORM",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Haven",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
